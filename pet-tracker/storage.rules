rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin(uid) {
      return firestore.exists(/databases/(default)/documents/admins/$(uid));
    }

    function hasAccess(uid) {
      return isAdmin(uid) || (
        firestore.exists(/databases/(default)/documents/accounts/$(uid)) &&
        firestore.get(/databases/(default)/documents/accounts/$(uid)).data.accessUntil != null &&
        firestore.get(/databases/(default)/documents/accounts/$(uid)).data.accessUntil > request.time.toMillis()
      );
    }

    // Photos are stored under pet-photos/{uid}/... so ownership can be
    // checked from the path alone; access (paid/free) is checked against
    // the matching Firestore accounts/admins collections.
    match /pet-photos/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && hasAccess(uid);
    }
  }
}
