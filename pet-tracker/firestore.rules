rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasAccess() {
      return isAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/accounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.accessUntil != null &&
        get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.accessUntil > request.time.toMillis()
      );
    }

    match /pets/{petId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid && hasAccess();
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && hasAccess();

      match /logs/{logId} {
        allow read, write: if request.auth != null && hasAccess() &&
          get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
      }
    }

    // Registration record per user, created once on first login with a
    // one-time trial (capped here at 31 days as a safety margin against
    // client clock skew - the app itself grants exactly 30). Since the
    // document can never be deleted, the trial can't be re-granted to the
    // same account later. Only admins can change access afterwards.
    match /accounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.trialUsed == true &&
        request.resource.data.accessUntil is int &&
        request.resource.data.accessUntil > request.time.toMillis() &&
        request.resource.data.accessUntil <= request.time.toMillis() + 2678400000;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Admin membership is managed manually in the Firebase console, never
    // through the app itself.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
